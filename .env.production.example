NODE_ENV=production
PORT=10000
HOST=0.0.0.0
SERVE_FRONTEND=true

# Same-origin deployment means ALLOWED_ORIGINS may stay empty until you add another trusted frontend.
ALLOWED_ORIGINS=
SESSION_SAMESITE=Lax
SESSION_TTL_MS=1209600000

# Render persistent disk example.
MEETMART_DATA_DIR=/var/data
MEETMART_DB_PATH=/var/data/meetmart.sqlite
MEETMART_UPLOAD_DIR=/var/data/uploads
MEETMART_BACKUP_DIR=/var/data/backups
MEETMART_STORAGE_MODE=persistent_disk

MAX_IMAGE_BYTES=5242880
MAX_JSON_BYTES=1000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT=180
RATE_LIMIT_AUTH=20
RATE_LIMIT_SENSITIVE=12
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7

MEETMART_COMMISSION_RATE=0.05
MEETMART_CUSTOMER_SERVICE_FEE=300

# STAGING ONLY until real provider contracts/credentials are connected.
IDENTITY_PROVIDER_MODE=demo
ASD_PAY_MODE=demo
ALLOW_DEMO_PROVIDERS=true

# Generate these in your deployment secret manager. Never commit real values.
DELIVERY_PIN_SECRET=generate-a-unique-secret-of-at-least-32-characters
DELIVERY_ADDRESS_SECRET=generate-a-different-secret-of-at-least-32-characters
