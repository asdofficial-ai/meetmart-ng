# Frontend development only. Production uses same-origin API and can leave this unset.
VITE_API_BASE_URL=http://localhost:8787

# Backend
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_MS=1209600000
SESSION_SAMESITE=Lax
MEETMART_DATA_DIR=./server/data
MEETMART_DB_PATH=./server/data/meetmart.sqlite
MEETMART_UPLOAD_DIR=./server/data/uploads
MEETMART_BACKUP_DIR=./server/data/backups
MEETMART_STORAGE_MODE=local
MAX_IMAGE_BYTES=5242880
MAX_JSON_BYTES=1000000
MEETMART_COMMISSION_RATE=0.05
MEETMART_CUSTOMER_SERVICE_FEE=300
IDENTITY_PROVIDER_MODE=demo
ASD_PAY_MODE=demo
ALLOW_DEMO_PROVIDERS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT=180
RATE_LIMIT_AUTH=20
RATE_LIMIT_SENSITIVE=12
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
SERVE_FRONTEND=false

# Production-only provider credentials belong on the backend when contracts are ready.
# NIN_BVN_PROVIDER_CLIENT_ID=
# NIN_BVN_PROVIDER_CLIENT_SECRET=
# ASD_PAY_PROVIDER_SECRET=

# Required in production. Use two different random values of at least 32 characters.
DELIVERY_PIN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DELIVERY_ADDRESS_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
